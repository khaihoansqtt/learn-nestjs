# App
PORT=3000
NODE_ENV=development
GREETING_OWNER=shop-mini

# Database (khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=shop
DB_PASS=shop123
DB_NAME=shop_mini
DB_POOL_SIZE=10

# Seed admin (npm run db:seed)
SEED_ADMIN_EMAIL=admin@shop-mini.dev
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=Admin@123

# Auth JWT (M5) — secret DEV, đủ 32 ký tự để qua Joi. Deploy thật PHẢI đổi
# cả 2 (mang default lên production là app crash fail-fast, xem auth.config).
JWT_ACCESS_SECRET=dev-access-secret-toi-thieu-32-ky-tu-000
JWT_REFRESH_SECRET=dev-refresh-secret-toi-thieu-32-ky-tu-000
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
